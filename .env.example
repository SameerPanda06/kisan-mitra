# Caspian — FREE, no signup, no card. Mint a key with:
#   curl -s -X POST https://api.trycaspianai.com/v1/projects/sandbox-H \
#     -H 'Content-Type: application/json' -d '{"name":"kisan-mitra"}'
# The response has "api_key": "comm_sandbox_...". Paste it below.
# (Email, Telegram, Discord, Slack channels are free. The $25 hackathon
# credit is Featherless inference, not a Caspian payment.)
CASPIAN_API_KEY=

# Google Gemini — required for the LLM + vision. Use the Nexora key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional channel credentials. Email + Telegram are the two required channels.
TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK display name shown during install

# Agent identity
AGENT_EMAIL_USERNAME=kisan-mitra

# Runtime
PORT=3000
STORE_PATH=./data/store.json
